POSITIVE VARIABLES x(j);

VARIABLES z;

EQUATIONS
   OBJective
   xub
   cQ(QuadCons)
   cL(LinCons);

OBJective.. z =e= SUM(j, c0(j) * x(j))
  + 0.5*SUM((j,jj),x(j) * Q0(j,jj) *x(jj));

xub(j)..  x(j) =l= 1;

cQ(QuadCons).. g(QuadCons) =g=
  SUM(j, cmat(QuadCons,j)*x(j)) +
  0.5*SUM((j,jj),x(j) * Q(j,jj,QuadCons) *x(jj));

cL(LinCons)..
  SUM(j, Amat(LinCons,j)*x(j)) =l= b(LinCons);

model QPncg  /all/;

solve QPncg using nlp minimizing z;
